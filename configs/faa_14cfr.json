  "normalization": {
    "rules": [
      {
        "name": "far_part_ref",
        "pattern": "\\bfar\\s+part\\s*(\\d+)\\b",
        "replacement": "14 cfr \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "flight_level",
        "pattern": "\\bfl\\s*(\\d{2,3})\\b",
        "replacement": "fl\\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_celsius",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*celsius\\b",
        "replacement": "°c",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_fahrenheit",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*fahrenheit\\b",
        "replacement": "°f",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_code_of_federal_regulations",
        "pattern": "\\bcode\\s+of\\s+federal\\s+regulations\\b",
        "replacement": "cfr",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_title_section",
        "pattern": "\\btitle\\s*(\\d{1,2}),?\\s*(?:of\\s+the\\s+)?cfr,?\\s*section\\s*(\\d+)\\b",
        "replacement": "\\1 cfr \\2",
        "flags": "IGNORECASE"
      }
    ]
  }
