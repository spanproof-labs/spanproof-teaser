  "normalization": {
    "rules": [
      {
        "name": "hazard_division_class_synonymy",
        "pattern": "\\b(?:class|division|div)\\s*(\\d+(?:\\.\\d+)?)\\b",
        "replacement": "div \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "hazard_division_trailing_zero",
        "pattern": "\\bdiv\\s*(\\d+)\\.0\\b",
        "replacement": "div \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_celsius",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*celsius\\b",
        "replacement": "°c",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_fahrenheit",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*fahrenheit\\b",
        "replacement": "°f",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_deg_c",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*c\\b",
        "replacement": "°c",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_deg_f",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*f\\b",
        "replacement": "°f",
        "flags": "IGNORECASE"
      },
      {
        "name": "compound_rate_per",
        "pattern": "\\b([a-z]+)\\s+per\\s+([a-z0-9]+)\\b",
        "replacement": "\\1/\\2",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_code_of_federal_regulations",
        "pattern": "\\bcode\\s+of\\s+federal\\s+regulations\\b",
        "replacement": "cfr",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_section_of_title",
        "pattern": "\\bsection\\s+(\\d{2,3}\\.\\d+)\\s+of\\s+title\\s+(\\d{1,2})\\b",
        "replacement": "\\2 cfr \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_title_section",
        "pattern": "\\btitle\\s*(\\d{1,2}),?\\s*(?:of\\s+the\\s+)?cfr,?\\s*section\\s*(\\d+)\\b",
        "replacement": "\\1 cfr \\2",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_title_part_section",
        "pattern": "\\btitle\\s*(\\d{1,2}),?\\s*part\\s*(\\d{2,3}),?\\s*section\\s*(\\d+)\\b",
        "replacement": "\\1 cfr \\2.\\3",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_part_section",
        "pattern": "\\bpart\\s*(\\d{2,3}),?\\s*section\\s*(\\d+)\\b",
        "replacement": "\\1.\\2",
        "flags": "IGNORECASE"
      },
      {
        "name": "distributive_un_na_id_prefix",
        "pattern": "\\b(un|na|id)\\s*(?:numbers?|number\\(s\\)|codes?|code\\(s\\)|ids?|id\\(s\\))?\\s*(?:are|is|assigned|of)?\\s*(\\d{4})\\s*(?:and|or|,)\\s*(\\d{4})\\b",
        "replacement": "\\1\\2 \\1\\3",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_abbreviation",
        "pattern": "\\bpacking\\s*group\\b",
        "replacement": "pg",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_crammed_arabic",
        "pattern": "\\bpg([123])\\b",
        "replacement": "pg \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_crammed_roman",
        "pattern": "\\bpg(i{1,3}|iv|v)\\b",
        "replacement": "pg \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_three",
        "pattern": "\\b(packing group|pg|group|zone)\\s*(?:three|iii)\\b",
        "replacement": "\\1 3",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_two",
        "pattern": "\\b(packing group|pg|group|zone)\\s*(?:two|ii)\\b",
        "replacement": "\\1 2",
        "flags": "IGNORECASE"
      },
      {
        "name": "packing_group_one",
        "pattern": "\\b(packing group|pg|group|zone)\\s*(?:one|i)\\b",
        "replacement": "\\1 1",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_roman_bracket_normalization",
        "pattern": "\\[(i{1,3}|iv|v|vi{1,3}|ix|x)\\]",
        "replacement": "(\\1)",
        "flags": "IGNORECASE"
      }
    ]
  }
