  "normalization": {
    "rules": [
      {
        "name": "fda_device_class_normalization",
        "pattern": "\\b(?:medical\\s+)?device\\s+class(?:ification)?\\s*(?:three|iii)\\b",
        "replacement": "class 3",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_device_class_ii",
        "pattern": "\\b(?:medical\\s+)?device\\s+class(?:ification)?\\s*(?:two|ii)\\b",
        "replacement": "class 2",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_device_class_i",
        "pattern": "\\b(?:medical\\s+)?device\\s+class(?:ification)?\\s*(?:one|i)\\b",
        "replacement": "class 1",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_510k_normalization",
        "pattern": "\\b510\\s*\\(k\\)\\b",
        "replacement": "510k",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_section_of_title",
        "pattern": "\\bsection\\s+(\\d{1,4}\\.\\d+)\\s+of\\s+title\\s+21\\b",
        "replacement": "21 cfr \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_title_21_cfr",
        "pattern": "\\btitle\\s*21,?\\s*(?:of\\s+the\\s+)?cfr,?\\s*(?:section|part)\\s*(\\d+)\\b",
        "replacement": "21 cfr \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "fda_title_part_section",
        "pattern": "\\btitle\\s*21,?\\s*part\\s*(\\d{1,4}),?\\s*section\\s*(\\d+)\\b",
        "replacement": "21 cfr \\1.\\2",
        "flags": "IGNORECASE"
      },
      {
        "name": "cgmp_abbreviation",
        "pattern": "\\bcurrent\\s+good\\s+manufacturing\\s+practice(?:s)?\\b",
        "replacement": "cgmp",
        "flags": "IGNORECASE"
      },
      {
        "name": "gmp_abbreviation",
        "pattern": "\\bgood\\s+manufacturing\\s+practice(?:s)?\\b",
        "replacement": "gmp",
        "flags": "IGNORECASE"
      },
      {
        "name": "haccp_abbreviation",
        "pattern": "\\bhazard\\s+analysis\\s+(?:and\\s+)?critical\\s+control\\s+point(?:s)?\\b",
        "replacement": "haccp",
        "flags": "IGNORECASE"
      },
      {
        "name": "fsma_abbreviation",
        "pattern": "\\bfood\\s+safety\\s+modernization\\s+act\\b",
        "replacement": "fsma",
        "flags": "IGNORECASE"
      },
      {
        "name": "pma_abbreviation",
        "pattern": "\\bpremarket\\s+approval\\s+(?:application)?\\b",
        "replacement": "pma",
        "flags": "IGNORECASE"
      },
      {
        "name": "ide_abbreviation",
        "pattern": "\\binvestigational\\s+device\\s+exemption\\b",
        "replacement": "ide",
        "flags": "IGNORECASE"
      },
      {
        "name": "ind_abbreviation",
        "pattern": "\\binvestigational\\s+new\\s+drug\\s+(?:application)?\\b",
        "replacement": "ind",
        "flags": "IGNORECASE"
      },
      {
        "name": "nda_abbreviation",
        "pattern": "\\bnew\\s+drug\\s+application\\b",
        "replacement": "nda",
        "flags": "IGNORECASE"
      },
      {
        "name": "anda_abbreviation",
        "pattern": "\\babbreviated\\s+new\\s+drug\\s+application\\b",
        "replacement": "anda",
        "flags": "IGNORECASE"
      },
      {
        "name": "gras_abbreviation",
        "pattern": "\\bgenerally\\s+recognized\\s+as\\s+safe\\b",
        "replacement": "gras",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_code_of_federal_regulations",
        "pattern": "\\bcode\\s+of\\s+federal\\s+regulations\\b",
        "replacement": "cfr",
        "flags": "IGNORECASE"
      },
      {
        "name": "compound_rate_per",
        "pattern": "\\b([a-z]+)\\s+per\\s+([a-z0-9]+)\\b",
        "replacement": "\\1/\\2",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_celsius",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*celsius\\b",
        "replacement": "°c",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_fahrenheit",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*fahrenheit\\b",
        "replacement": "°f",
        "flags": "IGNORECASE"
      }
    ]
  }
