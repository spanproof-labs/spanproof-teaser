  "normalization": {
    "rules": [
      {
        "name": "sec_rule_ref",
        "pattern": "\\brule\\s+(\\d+[a-z]*(?:-\\d+)?)\\b",
        "replacement": "rule \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "sec_form_ref",
        "pattern": "\\bform\\s+(\\d+[a-z]*(?:-[a-z0-9]+)?)\\b",
        "replacement": "form \\1",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_celsius",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*celsius\\b",
        "replacement": "°c",
        "flags": "IGNORECASE"
      },
      {
        "name": "temperature_fahrenheit",
        "pattern": "\\b(?:degrees?|deg\\.?)\\s*fahrenheit\\b",
        "replacement": "°f",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_code_of_federal_regulations",
        "pattern": "\\bcode\\s+of\\s+federal\\s+regulations\\b",
        "replacement": "cfr",
        "flags": "IGNORECASE"
      },
      {
        "name": "cfr_title_section",
        "pattern": "\\btitle\\s*(\\d{1,2}),?\\s*(?:of\\s+the\\s+)?cfr,?\\s*section\\s*(\\d+)\\b",
        "replacement": "\\1 cfr \\2",
        "flags": "IGNORECASE"
      }
    ]
